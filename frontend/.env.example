# Copy to .env.local for local development. Both values are read on the server only —
# neither is prefixed NEXT_PUBLIC_, so neither is ever sent to the browser.

# Where the Django API lives.
BACKEND_URL=http://127.0.0.1:8000

# Must match the backend's PROVIDER_WEBHOOK_SECRET, or simulated webhooks get a 401.
# This is the backend's development default; both sides fall back to it, so the demo
# works with no .env.local at all.
PROVIDER_WEBHOOK_SECRET=dev-webhook-secret-change-me
